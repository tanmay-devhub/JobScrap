# Copy to .env for local use. Placeholders only - never commit real values.
JOBMONITOR_CONFIG_PATH=config.yaml
JOBMONITOR_DB_PATH=data/jobmonitor.sqlite3
JOBMONITOR_LOG_LEVEL=INFO

# Optional Google Sheets publishing
JOBMONITOR_SHEETS_ENABLED=false
JOBMONITOR_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
# Path to the service-account key file (kept OUTSIDE the repo), or the JSON itself (CI secret)
JOBMONITOR_GOOGLE_SERVICE_ACCOUNT_JSON=~/.config/jobmonitor/service-account.json
